---
import { ASSOCIATION_BANK } from '../lib/constants';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const bank = ASSOCIATION_BANK;
const groupedAccount = bank.accountNumber.replace(/(\d{4})(?=\d)/g, '$1 ');
---

<section
  class:list={['card-elevate rounded-xl bg-canvas dark:bg-slate-900', compact ? 'p-4' : 'p-5 sm:p-6']}
  aria-labelledby="bank-details-title"
  data-bank-details
>
  <p class="font-mono text-xs uppercase tracking-[0.16em] text-mute dark:text-slate-400">Association Bank account</p>
  <h2 id="bank-details-title" class:list={['mt-2 font-semibold tracking-tight', compact ? 'text-base' : 'text-lg']}>
    {bank.bank}
  </h2>

  <dl class:list={['mt-3 grid gap-x-6 gap-y-3 text-sm', compact ? 'sm:grid-cols-3' : 'sm:grid-cols-2']}>
    <div>
      <dt class="text-mute dark:text-slate-400">Account number</dt>
      <dd class="mt-0.5 flex items-center gap-2">
        <span class="font-mono text-base tabular-nums text-ink dark:text-slate-100">{groupedAccount}</span>
        <button type="button" class="bank-copy" data-copy={bank.accountNumber} aria-label="Copy account number">Copy</button>
      </dd>
    </div>
    <div>
      <dt class="text-mute dark:text-slate-400">IFSC</dt>
      <dd class="mt-0.5 flex items-center gap-2">
        <span class="font-mono text-base text-ink dark:text-slate-100">{bank.ifsc}</span>
        <button type="button" class="bank-copy" data-copy={bank.ifsc} aria-label="Copy IFSC code">Copy</button>
      </dd>
    </div>
    <div>
      <dt class="text-mute dark:text-slate-400">Branch</dt>
      <dd class="mt-0.5 text-ink dark:text-slate-100">{bank.branch}</dd>
    </div>
    {!compact && (
      <>
        <div>
          <dt class="text-mute dark:text-slate-400">MICR</dt>
          <dd class="mt-0.5 font-mono text-ink dark:text-slate-100">{bank.micr}</dd>
        </div>
        <div class="sm:col-span-2">
          <dt class="text-mute dark:text-slate-400">Branch address</dt>
          <dd class="mt-0.5 text-ink dark:text-slate-100">{bank.branchAddress}</dd>
        </div>
      </>
    )}
  </dl>

  <p class="mt-3 text-xs leading-5 text-mute dark:text-slate-400">
    Please mention your flat number in the transfer remarks.
  </p>
</section>

<script is:inline>
  (() => {
    if (window.__bankCopyBound) return;
    window.__bankCopyBound = true;
    document.addEventListener('click', async (event) => {
      const button = event.target instanceof Element ? event.target.closest('.bank-copy') : null;
      if (!button) return;
      const value = button.getAttribute('data-copy') || '';
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        const field = document.createElement('textarea');
        field.value = value;
        document.body.append(field);
        field.select();
        document.execCommand('copy');
        field.remove();
      }
      const label = button.textContent;
      button.textContent = 'Copied';
      button.setAttribute('data-copied', '');
      setTimeout(() => {
        button.textContent = label;
        button.removeAttribute('data-copied');
      }, 1500);
    });
  })();
</script>
