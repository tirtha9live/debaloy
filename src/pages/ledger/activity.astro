---

import Layout from '../../layouts/Layout.astro';

import Navigation from '../../components/Navigation.astro';

import Footer from '../../components/Footer.astro';

import LedgerHeader from '../../components/LedgerHeader.astro';

import AdminTabs from '../../components/AdminTabs.astro';

import { ASSOCIATION } from '../../lib/constants';

import { formatDateTime } from '../../lib/format';

import {

  displayRole,

  displaySheet,

  formatActiveDuration,

  listLedgerAudit,

  listLoginEvents,

  listPopularPages,

  listRecentPageViews,

  listSessionEngagement,

  loginOutcomeLabel,

  shortId,

} from '../../lib/activity';

import { currentKolkataYear, listJobRuns } from '../../lib/bank-holidays';



if (!Astro.locals.canEdit) {

  return Astro.redirect(Astro.locals.viewAsResident ? '/ledger?view=resident' : '/ledger');

}



const sessions = await listSessionEngagement();

const popular = await listPopularPages();

const pageTrail = await listRecentPageViews();

const audits = await listLedgerAudit();

const events = await listLoginEvents();

const jobRuns = await listJobRuns(30);

const jobYear = currentKolkataYear();

const jobAction = Astro.url.searchParams.get('job') ?? '';

const jobResult = Astro.url.searchParams.get('result') ?? '';

const jobActions = [
  {
    intent: 'all',
    label: 'Fetch all + consolidate',
    title: `Fetch bank holidays and festival dates for ${jobYear}, then consolidate?`,
    copy: 'Same as the 1 January 10:30 run: HDFC and Drik Panchang are fetched together, then the festival calendar is rebuilt.',
    primary: true,
  },
  {
    intent: 'bank',
    label: 'Fetch bank holidays',
    title: `Fetch ${jobYear} bank holidays now?`,
    copy: 'Reads the West Bengal list from HDFC Bank, replaces the saved list if it is complete, then rebuilds the festival calendar.',
  },
  {
    intent: 'drik',
    label: 'Fetch festival dates',
    title: `Fetch ${jobYear} festival dates now?`,
    copy: 'Reads the Kolkata festival dates from Drik Panchang, replaces the saved dates if complete, then rebuilds the festival calendar.',
  },
  {
    intent: 'consolidate',
    label: 'Consolidate calendar',
    title: `Rebuild the ${jobYear} festival calendar?`,
    copy: 'Merges the fixed dates with the saved bank list and Drik dates, without fetching anything.',
  },
];

const jobLabel = (intent: string) => jobActions.find((item) => item.intent === intent)?.label ?? 'Job';



function pathLabel(path: string) {

  const base = path.split('?')[0];

  const map: Record<string, string> = {

    '/ledger': 'Home',

    '/ledger/maintenance': 'Maintenance',

    '/ledger/puja': 'Puja',

    '/ledger/income': 'Other collections',

    '/ledger/expenses': 'Expenses',

    '/ledger/withdrawals': 'Withdrawals',

    '/ledger/receipts': 'This year’s account',

    '/ledger/years': 'Years',

    '/ledger/handover': 'Archive',

    '/ledger/activity': 'Activity',

    '/ledger/bank-holidays': 'Bank holidays',

    '/ledger/festival-photos': 'Festival photos',

  };

  return map[base] ?? (base.replace('/ledger/', '').replace(/-/g, ' ') || 'Page');

}

---



<Layout title={`Admin · Activity · ${ASSOCIATION}`} noindex>

  <Navigation current="activity" />

  <main id="main" class="mx-auto max-w-[1400px] px-4 py-6 sm:px-6 sm:py-10">

    <LedgerHeader

      sheet="activity"

      title="Admin."

      subtitle="Engagement by session (pages and time on site), background jobs, and a ledger change audit when someone with edit access confirms a save. Residents share one password; sessions are still separated by browser login."

    />

    <AdminTabs current="activity" />



    <div id="sheet-capture" class="mt-8 space-y-10">

      <section>
        <h2 class="text-lg font-semibold tracking-tight" id="background-jobs">Background jobs</h2>
        <p class="mt-1 text-sm text-body dark:text-slate-300">
          On 1 January at 10:30 IST bank holidays (HDFC) and festival dates (Drik Panchang, Kolkata) are fetched together and consolidated into the year’s festival calendar; at 18:00 IST whichever failed is fetched again and the calendar is consolidated again. Use the buttons below to force any step; every run is logged here. Festival photos are never fetched automatically; change them under Festival photos.
        </p>
        <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:flex lg:flex-wrap">
          {jobActions.map((action) => (
            <form
              method="post"
              action="/api/ledger/calendar-jobs"
              data-ledger-form
              data-confirm-action
              data-confirm-title={action.title}
              data-confirm-copy={action.copy}
              data-confirm-label={action.label}
              data-confirm-rows={JSON.stringify([{ label: 'Year', from: '—', to: String(jobYear) }])}
            >
              <button
                type="submit"
                name="intent"
                value={action.intent}
                class:list={[
                  'inline-flex h-11 w-full items-center justify-center rounded-md px-4 text-sm font-medium lg:w-auto',
                  action.primary
                    ? 'bg-primary text-on-primary dark:bg-slate-100 dark:text-slate-950'
                    : 'border border-hairline dark:border-slate-700',
                ]}
              >
                {action.label}
              </button>
            </form>
          ))}
        </div>
        {jobAction && jobResult === 'ok' && (
          <p class="mt-3 rounded-md bg-canvas-soft px-3 py-2 text-sm text-body dark:bg-slate-800 dark:text-slate-300" role="status">
            {jobLabel(jobAction)} finished. See the log below.
          </p>
        )}
        {jobAction && jobResult === 'failed' && (
          <p class="mt-3 rounded-md bg-error-soft px-3 py-2 text-sm text-error-deep dark:bg-red-950/40 dark:text-red-200" role="alert">
            {jobLabel(jobAction)} failed. The reason is in the log below.
          </p>
        )}
        {jobAction && jobResult === 'wait' && (
          <p class="mt-3 rounded-md bg-canvas-soft px-3 py-2 text-sm text-body dark:bg-slate-800 dark:text-slate-300" role="status">
            {jobLabel(jobAction)} ran less than a minute ago. Try again shortly.
          </p>
        )}
        {!jobResult && ['bank_holidays', 'drik_festivals'].some((job) => jobRuns.find((run) => run.job === job && run.status !== 'skipped')?.status === 'failed') && (
          <p class="mt-3 rounded-md bg-error-soft px-3 py-2 text-sm text-error-deep dark:bg-red-950/40 dark:text-red-200" role="alert">
            The latest bank holiday or festival date fetch failed. Use the buttons above to fetch again, or check the source page.
          </p>
        )}
        <div class="card-elevate mt-3 overflow-hidden rounded-xl bg-canvas dark:bg-slate-900">
          <div class="sheet-scroll">
            <table class="sheet-table w-full">
              <thead>
                <tr>
                  <th class="text-left">When</th>
                  <th class="text-left">Job</th>
                  <th class="text-left">Trigger</th>
                  <th class="text-left">Result</th>
                  <th class="text-left">Detail</th>
                </tr>
              </thead>
              <tbody>
                {jobRuns.length === 0 && (
                  <tr>
                    <td colspan="5" class="whitespace-normal text-body dark:text-slate-300">No job runs yet.</td>
                  </tr>
                )}
                {jobRuns.map((run) => (
                  <tr>
                    <td class="whitespace-nowrap">{formatDateTime(run.at)}</td>
                    <td>
                      {run.job === 'festival_images'
                        ? 'Festival photos'
                        : run.job === 'drik_festivals'
                          ? 'Festival dates'
                          : run.job === 'festival_calendar'
                            ? 'Festival calendar'
                            : 'Bank holidays'}
                    </td>
                    <td>
                      {run.trigger === 'cron'
                        ? '1 Jan 10:30'
                        : run.trigger === 'retry'
                          ? '1 Jan 18:00 retry'
                          : run.trigger === 'auto'
                            ? (run.job === 'festival_images' ? 'Festival window' : 'List missing')
                            : 'Manual (treasurer)'}
                    </td>
                    <td class:list={[run.status === 'failed' && 'font-medium text-error']}>
                      {run.status === 'ok' ? 'OK' : run.status === 'failed' ? 'Failed' : 'Skipped'}
                    </td>
                    <td class="max-w-md whitespace-normal">{run.detail}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section>

        <h2 class="text-lg font-semibold tracking-tight">Popular pages</h2>

        <p class="mt-1 text-sm text-body dark:text-slate-300">Total active time and visits across recent sessions.</p>

        <div class="card-elevate mt-3 overflow-hidden rounded-xl bg-canvas dark:bg-slate-900">

          <div class="sheet-scroll sheet-freeze">

            <table class="sheet-table w-full">

              <thead>

                <tr>

                  <th class="text-left">Page</th>

                  <th class="text-right">Visits</th>

                  <th class="text-right">Active time</th>

                </tr>

              </thead>

              <tbody>

                {popular.length === 0 && (

                  <tr>

                    <td colspan="3" class="whitespace-normal text-body dark:text-slate-300">No page views yet.</td>

                  </tr>

                )}

                {popular.map((row) => (

                  <tr>

                    <td class="whitespace-normal">

                      <span class="font-medium">{pathLabel(row.path)}</span>

                      <span class="mt-0.5 block font-mono text-xs text-mute dark:text-slate-400">{row.path}</span>

                    </td>

                    <td class="text-right tabular-nums">{row.visits}</td>

                    <td class="text-right tabular-nums">{formatActiveDuration(row.activeSec)}</td>

                  </tr>

                ))}

              </tbody>

            </table>

          </div>

        </div>

      </section>



      <section>

        <h2 class="text-lg font-semibold tracking-tight">Sessions</h2>

        <p class="mt-1 text-sm text-body dark:text-slate-300">

          {sessions.length} recent {sessions.length === 1 ? 'session' : 'sessions'}. Active time includes navigation and time on a page before switching or leaving.

        </p>

        <p class="sheet-swipe-hint mt-3">Swipe sideways for IP, device, and session id.</p>

        <div class="card-elevate mt-2 overflow-hidden rounded-xl bg-canvas dark:bg-slate-900">

          <div class="sheet-scroll sheet-freeze">

            <table class="sheet-table w-full">

              <thead>

                <tr>

                  <th class="text-left">Last seen</th>

                  <th class="text-left">First seen</th>

                  <th class="text-left">Role</th>

                  <th class="text-right">Pages</th>

                  <th class="text-right">Active time</th>

                  <th class="text-right">Downloads</th>

                  <th class="text-left">IP</th>

                  <th class="text-left">Device</th>

                  <th class="text-left">Session</th>

                </tr>

              </thead>

              <tbody>

                {sessions.length === 0 && (

                  <tr>

                    <td colspan="9" class="whitespace-normal text-body dark:text-slate-300">No sessions yet.</td>

                  </tr>

                )}

                {sessions.map((row) => (

                  <tr>

                    <td class="whitespace-nowrap">{formatDateTime(row.lastSeen)}</td>

                    <td class="whitespace-nowrap">{formatDateTime(row.firstSeen)}</td>

                    <td>{displayRole(row.role)}</td>

                    <td class="text-right tabular-nums">{row.pageViews}</td>

                    <td class="text-right tabular-nums">{formatActiveDuration(row.activeSec)}</td>

                    <td class="text-right tabular-nums">{row.downloads}</td>

                    <td class="font-mono text-xs">{row.ip || '—'}</td>

                    <td>{row.device || '—'}</td>

                    <td class="font-mono text-xs" title={row.sessionId}>{shortId(row.sessionId)}</td>

                  </tr>

                ))}

              </tbody>

            </table>

          </div>

        </div>

      </section>



      <section>

        <h2 class="text-lg font-semibold tracking-tight">Page trail</h2>

        <p class="mt-1 text-sm text-body dark:text-slate-300">Recent page opens across all sessions (newest first).</p>

        <div class="card-elevate mt-3 overflow-hidden rounded-xl bg-canvas dark:bg-slate-900">

          <div class="sheet-scroll sheet-freeze">

            <table class="sheet-table w-full">

              <thead>

                <tr>

                  <th class="text-left">When</th>

                  <th class="text-left">Page</th>

                  <th class="text-left">Role</th>

                  <th class="text-right">Time on page</th>

                  <th class="text-left">Session</th>

                </tr>

              </thead>

              <tbody>

                {pageTrail.length === 0 && (

                  <tr>

                    <td colspan="5" class="whitespace-normal text-body dark:text-slate-300">No page views yet.</td>

                  </tr>

                )}

                {pageTrail.map((row) => (

                  <tr>

                    <td class="whitespace-nowrap">{formatDateTime(row.startedAt)}</td>

                    <td class="max-w-xs whitespace-normal">

                      <span class="font-medium">{pathLabel(row.path)}</span>

                      <span class="mt-0.5 block truncate font-mono text-xs text-mute dark:text-slate-400" title={row.path}>{row.path}</span>

                    </td>

                    <td>{displayRole(row.role)}</td>

                    <td class="text-right tabular-nums">{formatActiveDuration(row.durationSec)}</td>

                    <td class="font-mono text-xs" title={row.sessionId}>{shortId(row.sessionId)}</td>

                  </tr>

                ))}

              </tbody>

            </table>

          </div>

        </div>

      </section>



      <section>

        <h2 class="text-lg font-semibold tracking-tight">Ledger changes</h2>

        <p class="mt-1 text-sm text-body dark:text-slate-300">

          Values recorded when edit access confirms a save (same checklist as the confirm dialog). Passwords are never stored.

        </p>

        <div class="card-elevate mt-3 overflow-hidden rounded-xl bg-canvas dark:bg-slate-900">

          <div class="sheet-scroll sheet-freeze">

            <table class="sheet-table w-full">

              <thead>

                <tr>

                  <th class="text-left">When</th>

                  <th class="text-left">Sheet</th>

                  <th class="text-left">Field</th>

                  <th class="text-left">From</th>

                  <th class="text-left">To</th>

                  <th class="text-left">Role</th>

                  <th class="text-left">Session</th>

                </tr>

              </thead>

              <tbody>

                {audits.length === 0 && (

                  <tr>

                    <td colspan="7" class="whitespace-normal text-body dark:text-slate-300">No saved changes logged yet.</td>

                  </tr>

                )}

                {audits.map((row) => (

                  <tr>

                    <td class="whitespace-nowrap">{formatDateTime(row.at)}</td>

                    <td>{displaySheet(row.sheet)}</td>

                    <td class="max-w-40 whitespace-normal">{row.fieldLabel}</td>

                    <td class="max-w-32 truncate font-mono text-xs" title={row.oldValue}>{row.oldValue || '—'}</td>

                    <td class="max-w-32 truncate font-mono text-xs" title={row.newValue}>{row.newValue || '—'}</td>

                    <td>{displayRole(row.role)}</td>

                    <td class="font-mono text-xs" title={row.sessionId}>{shortId(row.sessionId)}</td>

                  </tr>

                ))}

              </tbody>

            </table>

          </div>

        </div>

      </section>



      <section>

        <h2 class="text-lg font-semibold tracking-tight">Login audit</h2>

        <p class="mt-1 text-sm text-body dark:text-slate-300">Signed in, signed out, wrong password, and lockouts.</p>

        <p class="sheet-swipe-hint mt-3">Swipe sideways to see IP and session.</p>

        <div class="card-elevate mt-2 overflow-hidden rounded-xl bg-canvas dark:bg-slate-900">

          <div class="sheet-scroll sheet-freeze">

            <table class="sheet-table w-full">

              <thead>

                <tr>

                  <th class="text-left">When</th>

                  <th class="text-left">Event</th>

                  <th class="text-left">Role</th>

                  <th class="text-left">IP</th>

                  <th class="text-left">Device</th>

                  <th class="text-left">Session</th>

                </tr>

              </thead>

              <tbody>

                {events.length === 0 && (

                  <tr>

                    <td colspan="6" class="whitespace-normal text-body dark:text-slate-300">No login events yet.</td>

                  </tr>

                )}

                {events.map((row) => (

                  <tr>

                    <td class="whitespace-nowrap">{formatDateTime(row.at)}</td>

                    <td>{loginOutcomeLabel(row.outcome)}</td>

                    <td>{displayRole(row.role)}</td>

                    <td class="font-mono text-xs">{row.ip || '—'}</td>

                    <td>{row.device || '—'}</td>

                    <td class="font-mono text-xs" title={row.sessionId ?? ''}>{shortId(row.sessionId)}</td>

                  </tr>

                ))}

              </tbody>

            </table>

          </div>

        </div>

      </section>

    </div>

  </main>

  <Footer />

  <script src="../../scripts/ledger-actions.ts"></script>

</Layout>


