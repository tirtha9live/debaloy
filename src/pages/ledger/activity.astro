---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import LedgerHeader from '../../components/LedgerHeader.astro';
import { ASSOCIATION } from '../../lib/constants';
import { formatDateTime } from '../../lib/format';
import {
  displayRole,
  listLoginEvents,
  listVisitors,
  loginOutcomeLabel,
  shortId,
} from '../../lib/activity';

if (!Astro.locals.canEdit) {
  return Astro.redirect(Astro.locals.viewAsResident ? '/ledger?view=resident' : '/ledger');
}

const visitors = await listVisitors();
const events = await listLoginEvents();
---

<Layout title={`Activity · ${ASSOCIATION}`} noindex>
  <Navigation current="activity" />
  <main id="main" class="mx-auto max-w-[1400px] px-4 py-6 sm:px-6 sm:py-10">
    <LedgerHeader
      sheet="activity"
      title="Activity."
      subtitle="Resident access is a shared password, so this page lists sessions by IP and device. Login events keep an audit trail for treasurer access, and can take more roles later."
    />

    <section class="mt-8">
      <h2 class="text-lg font-semibold tracking-tight">Sessions</h2>
      <p class="mt-1 text-sm text-body dark:text-slate-300">{visitors.length} recent {visitors.length === 1 ? 'session' : 'sessions'}.</p>
      <p class="sheet-swipe-hint mt-3">Swipe sideways to see IP, device, and session id.</p>
      <div id="sheet-capture" class="card-elevate mt-2 overflow-hidden rounded-xl bg-canvas dark:bg-slate-900">
        <div class="sheet-scroll">
          <table class="sheet-table w-full">
            <thead>
              <tr>
                <th class="text-left">Last seen</th>
                <th class="text-left">First seen</th>
                <th class="text-left">Role</th>
                <th class="text-left">IP</th>
                <th class="text-left">Device</th>
                <th class="text-left">UA</th>
                <th class="text-right">Views</th>
                <th class="text-right">Downloads</th>
                <th class="text-left">Session</th>
                <th class="text-left">Fingerprint</th>
              </tr>
            </thead>
            <tbody>
              {visitors.length === 0 && (
                <tr>
                  <td colspan="10" class="whitespace-normal text-body dark:text-slate-300">No sessions yet.</td>
                </tr>
              )}
              {visitors.map((row) => (
                <tr>
                  <td class="whitespace-nowrap">{formatDateTime(row.lastSeen)}</td>
                  <td class="whitespace-nowrap">{formatDateTime(row.firstSeen)}</td>
                  <td>{displayRole(row.role)}</td>
                  <td class="font-mono text-xs">{row.ip || '—'}</td>
                  <td>{row.device || '—'}</td>
                  <td class="max-w-56 truncate" title={row.userAgent}>{row.userAgent || '—'}</td>
                  <td class="text-right tabular-nums">{row.views}</td>
                  <td class="text-right tabular-nums">{row.downloads}</td>
                  <td class="font-mono text-xs" title={row.sessionId}>{shortId(row.sessionId)}</td>
                  <td class="font-mono text-xs">{row.fingerprint || '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-lg font-semibold tracking-tight">Login audit</h2>
      <p class="mt-1 text-sm text-body dark:text-slate-300">Signed in, signed out, wrong password, and lockouts. Passwords are never stored.</p>
      <p class="sheet-swipe-hint mt-3">Swipe sideways to see IP and session.</p>
      <div class="card-elevate mt-2 overflow-hidden rounded-xl bg-canvas dark:bg-slate-900">
        <div class="sheet-scroll">
          <table class="sheet-table w-full">
            <thead>
              <tr>
                <th class="text-left">When</th>
                <th class="text-left">Event</th>
                <th class="text-left">Role</th>
                <th class="text-left">IP</th>
                <th class="text-left">Device</th>
                <th class="text-left">Session</th>
              </tr>
            </thead>
            <tbody>
              {events.length === 0 && (
                <tr>
                  <td colspan="6" class="whitespace-normal text-body dark:text-slate-300">No login events yet.</td>
                </tr>
              )}
              {events.map((row) => (
                <tr>
                  <td class="whitespace-nowrap">{formatDateTime(row.at)}</td>
                  <td>{loginOutcomeLabel(row.outcome)}</td>
                  <td>{displayRole(row.role)}</td>
                  <td class="font-mono text-xs">{row.ip || '—'}</td>
                  <td>{row.device || '—'}</td>
                  <td class="font-mono text-xs" title={row.sessionId ?? ''}>{shortId(row.sessionId)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script src="../../scripts/ledger-actions.ts"></script>
</Layout>
