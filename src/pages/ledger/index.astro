---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import LedgerHeader from '../../components/LedgerHeader.astro';
import { ASSOCIATION, SHEETS } from '../../lib/constants';
import { withLedger, withView } from '../../lib/auth';
import { formatInr } from '../../lib/format';
import { loadLedger } from '../../lib/ledger';

const snapshot = await loadLedger(Astro.locals.ledgerYear);
const viewAsResident = Astro.locals.viewAsResident;
---

<Layout title={`Ledger home · ${ASSOCIATION}`} noindex>
  <Navigation current="home" />
  <main id="main" class="mx-auto max-w-[1400px] px-4 py-6 sm:px-6 sm:py-10">
    <LedgerHeader
      sheet="overview"
      title="Building ledger."
      subtitle={`${ASSOCIATION} · ${snapshot.year.label}. Archive holds the original takeover record and closed years. This year’s account updates as you add collections and expenses. Withdrawals move cash from bank to hand and do not appear as a This Year line.`}
    />

    <div id="sheet-capture" class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <article class="card-elevate rounded-xl bg-canvas p-6 dark:bg-slate-900">
        <p class="font-mono text-xs uppercase tracking-[0.16em] text-mute dark:text-slate-400">Maintenance</p>
        <p class="mt-3 text-2xl font-semibold tabular-nums tracking-tight">{formatInr(snapshot.maintenanceTotals.grand)}</p>
        <p class="mt-1 text-sm text-body dark:text-slate-300">Bank {formatInr(snapshot.maintenanceTotals.bank)} · Cash {formatInr(snapshot.maintenanceTotals.cash)}</p>
      </article>
      <article class="card-elevate rounded-xl bg-canvas p-6 dark:bg-slate-900">
        <p class="font-mono text-xs uppercase tracking-[0.16em] text-mute dark:text-slate-400">Puja Contribution</p>
        <p class="mt-3 text-2xl font-semibold tabular-nums tracking-tight">{formatInr(snapshot.pujaTotal)}</p>
        <p class="mt-1 text-sm text-body dark:text-slate-300">Cash-only contribution</p>
      </article>
      <article class="card-elevate rounded-xl bg-canvas p-6 dark:bg-slate-900">
        <p class="font-mono text-xs uppercase tracking-[0.16em] text-mute dark:text-slate-400">Cash in hand</p>
        <p class="mt-3 text-2xl font-semibold tabular-nums tracking-tight">{formatInr(snapshot.cashInHand)}</p>
        <p class="mt-1 text-sm text-body dark:text-slate-300">Current cash at hand</p>
      </article>
      <article class="card-elevate rounded-xl bg-canvas p-6 dark:bg-slate-900">
        <p class="font-mono text-xs uppercase tracking-[0.16em] text-mute dark:text-slate-400">Cash in bank</p>
        <p class="mt-3 text-2xl font-semibold tabular-nums tracking-tight">{formatInr(snapshot.cashInBank)}</p>
        <p class="mt-1 text-sm text-body dark:text-slate-300">Current cash in bank</p>
      </article>
    </div>

    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {SHEETS.map((sheet) => (
        <a
          href={sheet.slug === 'handover' || sheet.slug === 'years' ? withView(sheet.href, viewAsResident) : withLedger(sheet.href, Astro.locals)}
          class="card-elevate min-h-24 rounded-xl bg-canvas p-5 transition-colors duration-200 hover:bg-canvas-soft dark:bg-slate-900 dark:hover:bg-slate-800"
        >
          <h2 class="text-lg font-semibold tracking-tight">{sheet.label}</h2>
          <p class="mt-1 text-sm text-body dark:text-slate-300">{sheet.hint}</p>
        </a>
      ))}
      {Astro.locals.canEdit && (
        <a
          href="/ledger/activity"
          class="card-elevate min-h-24 rounded-xl bg-canvas p-5 transition-colors duration-200 hover:bg-canvas-soft dark:bg-slate-900 dark:hover:bg-slate-800"
        >
          <h2 class="text-lg font-semibold tracking-tight">Activity</h2>
          <p class="mt-1 text-sm text-body dark:text-slate-300">Sessions, visitor IPs, and login audit</p>
        </a>
      )}
    </div>
  </main>
  <Footer />
  <script src="../../scripts/ledger-actions.ts"></script>
</Layout>
