---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import LedgerHeader from '../../components/LedgerHeader.astro';
import ReceiptsPaymentsSheet from '../../components/ReceiptsPaymentsSheet.astro';
import { ADDRESS, ASSOCIATION, HANDOVER_CLOSING_BANK, HANDOVER_CLOSING_CASH, HANDOVER_LINES, SHEETS } from '../../lib/constants';
import { withView } from '../../lib/auth';
import { displayDate, formatAmount } from '../../lib/format';

const receiptTotal = HANDOVER_LINES.reduce((sum, line) => sum + (line.receiptAmount ?? 0), 0);
const paymentTotal = HANDOVER_LINES.reduce((sum, line) => sum + (line.paymentAmount ?? 0), 0);
const frozen = (Astro.locals.ledgerYears ?? []).filter((year) => year.endDate);
const canManage = Astro.locals.session?.role === 'admin' && !Astro.locals.viewAsResident;
const viewAsResident = Astro.locals.viewAsResident;
const snapshotSheets = SHEETS.filter((sheet) => sheet.slug !== 'handover' && sheet.slug !== 'years');
const error = Astro.url.searchParams.get('error');
---

<Layout title={`Archive · ${ASSOCIATION}`} noindex>
  <Navigation current="handover" />
  <main id="main" class="mx-auto max-w-[1400px] px-4 py-6 sm:px-6 sm:py-10">
    <LedgerHeader
      sheet="handover"
      title="Archive."
      subtitle={canManage
        ? 'The original takeover record and closed years. Frozen years are read-only snapshots. Change a freeze date later and dated rows, maintenance months, and carry-forward cash move with it.'
        : 'The original takeover record and closed years. Frozen years are read-only snapshots.'}
    />

    {error && (
      <p class="mt-6 rounded-md bg-canvas-soft px-3 py-2 text-sm text-body dark:bg-slate-800 dark:text-slate-300">{error}</p>
    )}

    <section id="sheet-capture" class="card-elevate mt-8 overflow-hidden rounded-xl bg-canvas dark:bg-slate-900">
      <div class="border-b border-hairline px-4 py-5 text-center dark:border-slate-800 sm:px-6">
        <p class="text-lg font-semibold tracking-tight text-pretty" translate="no">{ASSOCIATION}</p>
        <p class="mt-1 text-sm text-pretty text-body dark:text-slate-300">{ADDRESS}</p>
        <p class="mt-2 text-sm font-medium text-pretty text-ink dark:text-slate-100">Receipts & Payments Account — Financial Year 2024-2026 (ended 31st August)</p>
        <p class="mt-2 font-mono text-xs uppercase tracking-[0.16em] text-mute dark:text-slate-400">Original takeover record · reference only</p>
      </div>
      <ReceiptsPaymentsSheet
        lines={HANDOVER_LINES}
        receiptTotal={receiptTotal}
        paymentTotal={paymentTotal}
      />
      <div class="grid gap-2 border-t border-hairline px-4 py-5 text-sm dark:border-slate-800 sm:grid-cols-2 sm:px-6">
        <p>Closing bank balance to FY 2026-27: <span class="font-medium tabular-nums">{formatAmount(HANDOVER_CLOSING_BANK)}</span></p>
        <p>Closing cash balance to FY 2026-27: <span class="font-medium tabular-nums">{formatAmount(HANDOVER_CLOSING_CASH)}</span></p>
      </div>
    </section>

    <section class="card-elevate mt-6 rounded-xl bg-canvas p-5 dark:bg-slate-900 sm:mt-8 sm:p-6">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-mute dark:text-slate-400">Closed years</p>
      <h2 class="mt-2 text-xl font-semibold tracking-tight">Frozen snapshots</h2>
      {frozen.length === 0 ? (
        <p class="mt-3 text-sm text-body dark:text-slate-300">No closed year yet. Closed years will appear here after the treasurer closes the books.</p>
      ) : (
        <ul class="mt-4 space-y-4">
          {frozen.map((year) => (
            <li class="border-t border-hairline pt-4 dark:border-slate-800">
              <p class="font-medium">{year.label}</p>
              <p class="mt-1 text-sm text-body dark:text-slate-300">
                {displayDate(year.startDate)} – {displayDate(year.endDate)}
              </p>
              <div class="mt-3 flex flex-wrap gap-2">
                {snapshotSheets.map((sheet) => (
                  <a
                    href={withView(sheet.href, viewAsResident, year.id)}
                    class="inline-flex h-10 items-center rounded-md border border-hairline px-3 text-sm dark:border-slate-700"
                  >
                    {sheet.label}
                  </a>
                ))}
              </div>
              {canManage && (
                <form method="post" action="/api/ledger/years" class="mt-3 space-y-2" data-ledger-form>
                  <input type="hidden" name="intent" value="update_end" />
                  <input type="hidden" name="year_id" value={year.id} />
                  <label class="block text-sm">
                    <span class="entry-label">Change freeze date</span>
                    <input class="sheet-input mt-1 max-w-xs" type="date" name="meeting_date" value={year.endDate ?? ''} min={year.startDate} required />
                  </label>
                  <button type="submit" class="inline-flex h-11 items-center rounded-md border border-hairline px-4 text-sm dark:border-slate-700">
                    Save freeze date
                  </button>
                </form>
              )}
            </li>
          ))}
        </ul>
      )}
    </section>
  </main>
  <Footer />
  <script src="../../scripts/ledger-actions.ts"></script>
</Layout>
