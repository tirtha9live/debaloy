---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import LedgerHeader from '../../components/LedgerHeader.astro';
import ReceiptsPaymentsSheet from '../../components/ReceiptsPaymentsSheet.astro';
import { ADDRESS, ASSOCIATION } from '../../lib/constants';
import { displayDate } from '../../lib/format';
import { buildReceiptsPayments, loadLedger } from '../../lib/ledger';

const snapshot = await loadLedger(Astro.locals.ledgerYear);
const report = buildReceiptsPayments(snapshot);
const canEdit = Astro.locals.canEdit;
---

<Layout title={`This year’s account · ${ASSOCIATION}`} noindex>
  <Navigation current="receipts" />
  <main id="main" class="mx-auto max-w-[1400px] px-4 py-6 sm:px-6 sm:py-10">
    <LedgerHeader
      sheet="receipts"
      title="This year’s account."
      subtitle={canEdit
        ? `The ${snapshot.year.label} receipts & payments statement, in the same form as the original takeover record. Totals update as Maintenance, Puja Contribution, Other Collections, and Expenses are added. Download Excel for the current statement.`
        : `The ${snapshot.year.label} receipts & payments statement. 0 on Maintenance means payment not required.`}
      canEdit={canEdit}
    />

    <form id="receipts-form" method="post" action="/api/ledger/settings" data-ledger-form class="mt-6 sm:mt-8">
      <button type="submit" class="sr-only" tabindex="-1" aria-hidden="true">Save sheet</button>
      <section id="sheet-capture" class="card-elevate overflow-hidden rounded-xl bg-canvas dark:bg-slate-900">
        <div class="border-b border-hairline px-4 py-5 text-center dark:border-slate-800 sm:px-6">
          <p class="text-lg font-semibold tracking-tight text-pretty" translate="no">{ASSOCIATION}</p>
          <p class="mt-1 text-sm text-pretty text-body dark:text-slate-300">{ADDRESS}</p>
          <p class="mt-2 text-sm font-medium text-pretty">Receipts & Payments Account — {snapshot.year.label} ({displayDate(snapshot.year.startDate)}{snapshot.year.endDate ? ` to ${displayDate(snapshot.year.endDate)}` : ' · open'})</p>
          <p class="mt-2 font-mono text-xs uppercase tracking-[0.16em] text-mute dark:text-slate-400">{snapshot.year.endDate ? 'Frozen snapshot' : 'Live statement · updates with new data'}</p>
        </div>
        <ReceiptsPaymentsSheet
          lines={report.lines}
          receiptTotal={report.receiptTotal}
          paymentTotal={report.paymentTotal}
          canEdit={canEdit}
          closing={{
            cash_in_hand: {
              computed: snapshot.computedCashInHand,
              overridden: snapshot.cashInHandOverride,
              refetch: 'refetch_cash_in_hand',
              label: 'Cash in Hand',
            },
            cash_in_bank: {
              computed: snapshot.computedCashInBank,
              overridden: snapshot.cashInBankOverride,
              refetch: 'refetch_cash_in_bank',
              label: 'Cash in Bank',
            },
          }}
        />
        <div class="border-t border-hairline px-4 py-4 text-sm leading-6 text-pretty text-body dark:border-slate-800 dark:text-slate-300 sm:px-6">
          Closing cash in hand and bank follow opening balances plus receipts minus expenses, split by Cash and Bank. Bank-to-cash withdrawals move money between the two closing figures and do not appear as a line here. Edit a figure to override; the circular fetch icon restores the amount from records. These become the opening balances of the next year.
        </div>
      </section>
    </form>
  </main>
  <Footer />
  <script src="../../scripts/ledger-actions.ts"></script>
</Layout>
