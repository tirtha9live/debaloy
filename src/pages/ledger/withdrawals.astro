---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import LedgerHeader from '../../components/LedgerHeader.astro';
import { ASSOCIATION } from '../../lib/constants';
import { displayDate, formatAmount } from '../../lib/format';
import { loadLedger } from '../../lib/ledger';

const snapshot = await loadLedger(Astro.locals.ledgerYear);
const canEdit = Astro.locals.canEdit;
const rows = snapshot.withdrawals;
---

<Layout title={`Withdrawals · ${ASSOCIATION}`} noindex>
  <Navigation current="withdrawals" />
  <main id="main" class="mx-auto max-w-[1400px] px-4 py-6 sm:px-6 sm:py-10">
    <LedgerHeader
      sheet="withdrawals"
      title="Bank withdrawals."
      subtitle={canEdit
        ? 'Record cash taken out of the bank. Closing cash in hand goes up and cash in bank goes down by the same amount. This year’s receipts and payments stay unchanged.'
        : 'Cash taken out of the bank. Increases cash in hand and decreases cash in bank.'}
    />

    <section id="sheet-capture" class="mt-6 grid gap-6 sm:mt-8 xl:grid-cols-[minmax(0,1fr)_20rem]">
      <div class="card-elevate overflow-hidden rounded-xl bg-canvas dark:bg-slate-900">
        {!canEdit && (
          <p class="sheet-swipe-hint px-4 pt-3">Swipe sideways if a row is wider than the screen.</p>
        )}
        <div class="sheet-scroll sheet-freeze">
          <table class="sheet-table w-full">
            <thead class:list={[canEdit && 'max-xl:hidden']}>
              <tr>
                <th class="text-left">Date</th>
                <th class="text-right">Amount (Rs.)</th>
                <th class="text-left">Note</th>
                {canEdit && <th></th>}
              </tr>
            </thead>
            <tbody>
              {rows.length === 0 && (
                <tr>
                  <td colspan={canEdit ? 4 : 3} class="whitespace-normal text-body dark:text-slate-300">No rows yet.</td>
                </tr>
              )}
              {rows.map((row) => (
                <tr>
                  {canEdit ? (
                    <td colspan={4} class="p-0">
                      <form method="post" action="/api/ledger/withdrawals" class="entry-form entry-form-withdraw" data-ledger-form>
                        <input type="hidden" name="id" value={row.id} />
                        <label class="entry-field">
                          <span class="entry-label">Date</span>
                          <input class="sheet-input" type="date" name="date" value={row.date ?? ''} />
                        </label>
                        <label class="entry-field">
                          <span class="entry-label">Amount</span>
                          <input class="sheet-input text-right" type="text" inputmode="decimal" name="amount" value={String(row.amount)} autocomplete="off" />
                        </label>
                        <label class="entry-field entry-field-wide">
                          <span class="entry-label">Note</span>
                          <input class="sheet-input" type="text" name="note" value={row.note} autocomplete="off" />
                        </label>
                        <div class="entry-actions">
                          <button type="submit" name="intent" value="update" class="entry-btn border border-hairline dark:border-slate-700">Save</button>
                          <button type="submit" name="intent" value="delete" class="entry-btn border border-error/30 text-error">Delete</button>
                        </div>
                      </form>
                    </td>
                  ) : (
                    <>
                      <td>{displayDate(row.date)}</td>
                      <td class="text-right tabular-nums">{formatAmount(row.amount)}</td>
                      <td class="max-w-xs whitespace-normal">{row.note}</td>
                    </>
                  )}
                </tr>
              ))}
              {canEdit && (
                <tr>
                  <td colspan={4} class="p-0">
                    <form method="post" action="/api/ledger/withdrawals" class="entry-form entry-form-withdraw border-t border-hairline dark:border-slate-800" data-ledger-form>
                      <input type="hidden" name="intent" value="create" />
                      <label class="entry-field">
                        <span class="entry-label">Date</span>
                        <input class="sheet-input" type="date" name="date" />
                      </label>
                      <label class="entry-field">
                        <span class="entry-label">Amount</span>
                        <input class="sheet-input text-right" type="text" inputmode="decimal" name="amount" placeholder="0.00" autocomplete="off" />
                      </label>
                      <label class="entry-field entry-field-wide">
                        <span class="entry-label">Note</span>
                        <input class="sheet-input" type="text" name="note" placeholder="ATM, cheque, or reason…" autocomplete="off" />
                      </label>
                      <div class="entry-actions">
                        <button type="submit" class="entry-btn bg-primary text-on-primary dark:bg-slate-100 dark:text-slate-950">Add row</button>
                      </div>
                    </form>
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>

      <aside class="card-elevate overflow-hidden rounded-xl bg-canvas dark:bg-slate-900">
        <table class="sheet-table w-full">
          <thead>
            <tr>
              <th class="text-left">Summary</th>
              <th class="text-right">Amount (Rs.)</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-cyan-deep text-white">
              <td class="font-medium">Withdrawn to cash</td>
              <td class="text-right font-medium tabular-nums">{formatAmount(snapshot.withdrawalsTotal)}</td>
            </tr>
          </tbody>
        </table>
        <p class="px-4 py-3 text-sm leading-6 text-body dark:text-slate-300">
          Not a receipt or expense. Cash in hand +{formatAmount(snapshot.withdrawalsTotal) || '0.00'} and cash in bank −{formatAmount(snapshot.withdrawalsTotal) || '0.00'}. Combined closing cash is unchanged.
        </p>
      </aside>
    </section>
  </main>
  <Footer />
  <script src="../../scripts/ledger-actions.ts"></script>
</Layout>
