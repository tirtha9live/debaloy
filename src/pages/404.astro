---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Page not found · Debaloy" noindex>
  <Navigation />
  <main id="main" class="mx-auto max-w-xl px-4 py-24 text-center sm:px-6">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-mute">Error 404</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight">Page not found.</h1>
    <p class="mt-4 text-body dark:text-slate-300">That address is not part of the Debaloy ledger.</p>
    <a href="/" class="mt-8 inline-flex h-11 items-center rounded-pill bg-primary px-5 text-sm font-medium text-on-primary dark:bg-slate-100 dark:text-slate-950">Return home</a>
  </main>
  <Footer />
</Layout>
