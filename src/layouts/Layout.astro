---
import '../styles/global.css';
import MaintenanceBanner from '../components/MaintenanceBanner.astro';

const maintenanceMode = Astro.locals.maintenanceMode ?? false;
const showTopBanner = maintenanceMode && Astro.url.pathname !== '/';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
}

const siteName = 'Debaloy';
const {
  title = 'Debaloy — Building ledger',
  description = 'Debaloy Flat Owners Welfare Association ledger for FY 2026-27. Access the maintenance, puja, income, withdrawals, and receipts record with a password.',
  canonical,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fafafa" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const storageKey = 'theme-preference';
        const cookieName = 'debaloy_theme';
        const cookieMaxAge = 60 * 60 * 24 * 400;
        const root = document.documentElement;
        const asTheme = (value) => (value === 'light' || value === 'dark' ? value : null);
        const readCookie = () => {
          const match = document.cookie.split('; ').find((part) => part.startsWith(`${cookieName}=`));
          return asTheme(match ? decodeURIComponent(match.slice(cookieName.length + 1)) : null);
        };
        const persistTheme = (theme) => {
          try {
            localStorage.setItem(storageKey, theme);
          } catch {
            /* Cookie still keeps the choice if storage is blocked. */
          }
          const secure = location.protocol === 'https:' ? '; Secure' : '';
          document.cookie = `${cookieName}=${theme}; Path=/; Max-Age=${cookieMaxAge}; SameSite=Lax${secure}`;
        };
        const getPreferredTheme = () => {
          const fromCookie = readCookie();
          if (fromCookie) return fromCookie;
          try {
            const fromStorage = asTheme(localStorage.getItem(storageKey));
            if (fromStorage) return fromStorage;
          } catch {
            /* Private mode can block storage. */
          }
          return 'light';
        };
        const applyTheme = (theme) => {
          root.dataset.theme = theme;
          root.classList.toggle('dark', theme === 'dark');
          root.style.colorScheme = theme;
          const themeColor = document.querySelector('meta[name="theme-color"]');
          if (themeColor) themeColor.setAttribute('content', theme === 'dark' ? '#020617' : '#fafafa');
        };
        const initialTheme = getPreferredTheme();
        applyTheme(initialTheme);
        if (readCookie() || initialTheme !== 'light') persistTheme(initialTheme);
        window.__setTheme = (theme) => {
          persistTheme(theme);
          applyTheme(theme);
          window.dispatchEvent(new CustomEvent('themechange', { detail: theme }));
        };
        window.__toggleTheme = () => {
          const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          window.__setTheme(nextTheme);
        };
      })();
    </script>
  </head>
  <body class="bg-canvas-soft text-ink font-sans antialiased dark:bg-slate-950 dark:text-slate-100">
    <a class="skip-link" href="#main">Skip to content</a>
    {showTopBanner && <MaintenanceBanner compact />}
    <slot />
    <div id="save-confirm" class="fixed inset-0 z-50 hidden" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="save-confirm-title">
      <button type="button" class="absolute inset-0 bg-ink/50" data-save-confirm-dismiss aria-label="Close confirmation"></button>
      <div
        class="pointer-events-none relative flex h-full items-end justify-center p-4 sm:items-center"
        style="padding-bottom: max(1rem, env(safe-area-inset-bottom))"
      >
        <div class="pointer-events-auto flex max-h-[85vh] w-full max-w-lg flex-col overflow-hidden rounded-xl border border-hairline bg-canvas shadow-lg dark:border-slate-700 dark:bg-slate-900">
          <div class="border-b border-hairline px-5 py-4 dark:border-slate-800">
            <h2 id="save-confirm-title" class="text-lg font-semibold tracking-tight text-ink dark:text-slate-100">Confirm these updates?</h2>
            <p id="save-confirm-copy" class="mt-1 text-sm text-body dark:text-slate-300">Nothing is saved until you confirm.</p>
          </div>
          <div id="save-confirm-list" class="min-h-0 flex-1 overflow-y-auto px-5 py-2"></div>
          <div class="grid grid-cols-2 gap-2 border-t border-hairline p-4 dark:border-slate-800">
            <button type="button" id="save-confirm-cancel" class="h-11 rounded-md border border-hairline text-sm font-medium dark:border-slate-700">
              Review again
            </button>
            <button type="button" id="save-confirm-ok" class="h-11 rounded-md bg-primary text-sm font-medium text-on-primary dark:bg-slate-100 dark:text-slate-950">
              Confirm save
            </button>
          </div>
        </div>
      </div>
    </div>
    <div id="json-import-confirm" class="fixed inset-0 z-50 hidden" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="json-import-title">
      <button type="button" class="absolute inset-0 bg-ink/50" data-json-import-dismiss aria-label="Close restore options"></button>
      <div
        class="pointer-events-none relative flex h-full items-end justify-center p-4 sm:items-center"
        style="padding-bottom: max(1rem, env(safe-area-inset-bottom))"
      >
        <div class="pointer-events-auto flex max-h-[85vh] w-full max-w-lg flex-col overflow-hidden rounded-xl border border-hairline bg-canvas shadow-lg dark:border-slate-700 dark:bg-slate-900">
          <div class="border-b border-hairline px-5 py-4 dark:border-slate-800">
            <h2 id="json-import-title" class="text-lg font-semibold tracking-tight text-ink dark:text-slate-100">Restore from JSON?</h2>
            <p id="json-import-copy" class="mt-1 text-sm text-body dark:text-slate-300">
              Merge keeps extra rows that are not in the file. Overwrite clears the live database, then imports this file.
            </p>
          </div>
          <p id="json-import-file-label" class="px-5 py-3 font-mono text-xs text-mute dark:text-slate-400"></p>
          <div class="grid grid-cols-1 gap-2 border-t border-hairline p-4 dark:border-slate-800 sm:grid-cols-3">
            <button type="button" id="json-import-cancel" class="h-11 rounded-md border border-hairline text-sm font-medium dark:border-slate-700">
              Cancel
            </button>
            <button type="button" id="json-import-merge" class="h-11 rounded-md border border-hairline text-sm font-medium dark:border-slate-700">
              Merge
            </button>
            <button type="button" id="json-import-overwrite" class="h-11 rounded-md bg-primary text-sm font-medium text-on-primary dark:bg-slate-100 dark:text-slate-950">
              Overwrite
            </button>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
